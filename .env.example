# Yahoo Fantasy Sports API credentials.
#
# Copy this to the cache dir (NOT the repo) so the token travels with the cache:
#   local:  data/cache/.env
#   colab:  /content/drive/MyDrive/fantasy/cache/.env
# `python -c "from src.data.paths import env_file; print(env_file())"` prints it.
#
# Get a key/secret from https://developer.yahoo.com/apps/
#   - Application Type:  Installed Application
#   - API Permissions:   Fantasy Sports -> Read
#   - Redirect URI:      oob
#
# Then run the consent flow once, LOCALLY (yfpy wants a localhost redirect,
# which does not work in a notebook):
#   python -m src.data.yahoo_league --auth
#
# That appends the token fields below automatically. To use the same session
# from Colab, copy the resulting .env into your Drive cache dir.

YAHOO_CONSUMER_KEY=
YAHOO_CONSUMER_SECRET=

# --- written by --auth; do not fill in by hand ---
# YAHOO_ACCESS_TOKEN=
# YAHOO_REFRESH_TOKEN=
# YAHOO_TOKEN_TIME=
# YAHOO_TOKEN_TYPE=
# YAHOO_GUID=
