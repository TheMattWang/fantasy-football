<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily draft-board refresh. Install with:

      cp scripts/com.claude.fantasy-board-refresh.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.claude.fantasy-board-refresh.plist

  Remove with:

      launchctl unload ~/Library/LaunchAgents/com.claude.fantasy-board-refresh.plist

  Runs at 06:30, before the 07:00 morning brief, so the brief reflects a board
  that has already been pulled forward. RunAtLoad fires it once on install so
  you find out immediately whether it works, rather than tomorrow morning.
-->
<!--
  PREREQUISITE, and it is not optional: `/bin/bash` needs Full Disk Access.

  This repo lives under ~/Documents, which macOS protects with TCC. A LaunchAgent
  runs as you but WITHOUT your TCC grants, so without the grant it cannot even
  read this script -- exit 126, "Operation not permitted" -- and it fails that way
  every single firing, quietly, into a log nobody reads.

  That is worse than no schedule at all, because it looks like coverage. Verified
  2026-08-25: read repo dir DENIED, read file DENIED, run venv python DENIED.
  See docs/findings/scheduling-blocked-by-tcc.md.

      System Settings -> Privacy & Security -> Full Disk Access -> add /bin/bash

  After loading, CHECK IT RAN: `launchctl list | grep fantasy` -- the middle
  column is the last exit status and it must be 0, not 126.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claude.fantasy-board-refresh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mattwang/Documents/fantasy/fantasy-football/scripts/refresh_board.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/mattwang/.claude/daily-log/fantasy-board-refresh.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mattwang/.claude/daily-log/fantasy-board-refresh.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>TZ</key>
        <string>America/Los_Angeles</string>
        <key>FANTASY_SEASON</key>
        <string>2026</string>
    </dict>
</dict>
</plist>
